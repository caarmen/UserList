<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat">
        <!-- Main theme colors -->
        <!--   your app branding color for the app bar -->
        <item name="colorPrimary">#00af59</item>
        <!--   darker variant for the status bar and contextual app bars -->
        <item name="colorPrimaryDark">#008a40</item>
        <!--   theme UI controls like checkboxes and text fields -->
        <item name="colorAccent">#ffff00</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="alertDialogTheme">@style/AppAlertDialogTheme</item>
    </style>
    <style name="AppAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">#ffff00</item>
    </style>
    <color name="background">#000</color>
    <color name="surface">#222</color>
</resources>
